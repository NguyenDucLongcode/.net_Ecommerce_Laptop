@model IEnumerable<ComChienMaDui.Models.Product>

<div class="col-xl-7">
    <form id="searchForm" asp-controller="Home" asp-action="Index" method="get">
        <div class="input-group w-100 mx-auto d-flex">
            <input type="search" name="searchQuery" value="@ViewBag.SearchQuery" class="form-control p-3" placeholder="Nhập tên sản phẩm..." aria-describedby="search-icon-1">
            <button type="submit" id="search-icon-1" class="input-group-text p-3 border-0"><i class="fa fa-search"></i></button>
        </div>
    </form>
</div>