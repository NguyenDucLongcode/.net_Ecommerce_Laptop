@model List<OrderDetail>

<div class="container mt-5">

    <h2 class="text-danger fw-bold mb-4">
        📦 Chi tiết đơn hàng
    </h2>

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-danger">

            <tr>

                <th>Hình ảnh</th>

                <th>Tên sản phẩm</th>

                <th>Giá</th>

                <th>Số lượng</th>

                <th>Thành tiền</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <!-- HÌNH -->

                    <td width="120">

                        <img src="@item.Product.Image"
                             width="100"
                             class="rounded" />

                    </td>

                    <!-- TÊN -->

                    <td>

                        <h5 class="fw-bold">
                            @item.Product.Name
                        </h5>

                    </td>

                    <!-- GIÁ -->

                    <td class="text-danger fw-bold">

                        @item.Price đ

                    </td>

                    <!-- SỐ LƯỢNG -->

                    <td>

                        @item.Quantity

                    </td>

                    <!-- THÀNH TIỀN -->

                    <td class="text-danger fw-bold">

                        @(item.Price* item.Quantity) đ

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>