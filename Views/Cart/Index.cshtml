@model List<ComChienMaDui.Models.Cart>
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container mt-5 mb-5">
    <!-- HIỂN THỊ THÔNG BÁO ĐẶT HÀNG THÀNH CÔNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm text-center" role="alert">
            <i class="fas fa-check-circle me-2 fs-4 align-middle"></i>
            <span class="fs-5 fw-bold">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <h2 class="mb-4 text-primary"><i class="fas fa-shopping-cart me-2"></i> Giỏ hàng của bạn</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center p-5 shadow-sm rounded">
            <h4>Giỏ hàng đang trống!</h4>
            <p>Vui lòng quay lại trang Sản phẩm để chọn mua những chiếc Laptop cực chiến nhé.</p>
            <a href="/Product" class="btn btn-primary rounded-pill px-4 py-2 mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row shadow-sm rounded p-3 bg-white">
            <div class="col-12">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th style="width: 150px; text-align: center;">Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="~/images/logo.png" alt="@item.Product?.Name" style="width: 80px; height: 80px; object-fit: contain;" class="me-3 border rounded p-1">
                                        <span class="fw-bold">@item.Product?.Name</span>
                                    </div>
                                </td>
                                <td>@(item.Product?.Price != null ? ((double)item.Product.Price).ToString("#,##0") : "0") đ</td>
                                
                                <td style="width: 150px;">
                                    <div class="input-group input-group-sm mb-1">
                                        <!-- Nút Trừ (-) -->
                                        @if (item.Quantity > 1)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.ProductId" asp-route-quantity="-1" class="btn btn-outline-secondary fw-bold">-</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId" class="btn btn-outline-danger fw-bold">-</a>
                                        }

                                        <!-- Ô Input Số Lượng -->
                                        <input type="number" class="form-control text-center bg-white" value="@item.Quantity" readonly>

                                        <!-- Nút Cộng (+) -->
                                        @if (item.Quantity < (item.Product?.Stock ?? 0))
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.ProductId" asp-route-quantity="1" class="btn btn-outline-secondary fw-bold">+</a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary fw-bold" onclick="alert('Rất tiếc, kho chỉ còn @(item.Product?.Stock ?? 0) sản phẩm này!')" style="opacity: 0.6;">+</button>
                                        }
                                    </div>
                                    <!-- Hiển thị kho -->
                                    <div class="text-center">
                                        <small class="text-muted">Còn lại: <strong>@(item.Product?.Stock ?? 0)</strong></small>
                                    </div>
                                </td>

                                <td class="text-danger fw-bold">
                                    @(item.Product?.Price != null ? ((double)(item.Product.Price * item.Quantity)).ToString("#,##0") : "0") đ
                                </td>
                                <td>
                                    <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <a href="/Product" class="btn btn-outline-secondary rounded-pill px-4"><i class="fas fa-arrow-left me-2"></i>Tiếp tục mua sắm</a>
            </div>
            <div class="col-md-6 text-end">
                <h4 class="mb-3">Tổng cộng: <span class="text-danger fw-bold fs-3">@Model.Sum(x => (x.Product?.Price ?? 0) * x.Quantity).ToString("#,##0") đ</span></h4>
                <a href="payment" class="btn btn-success btn-lg rounded-pill px-5 shadow">Tiến hành thanh toán <i class="fas fa-arrow-right ms-2"></i></a>
            </div>
        </div>
    }
</div>

